NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase Pooled Connection String (port 6543) - used by app runtime & webhooks
DATABASE_URL=

# Supabase Direct Connection String (port 5432) - used by prisma migrate
DIRECT_URL=

# --- Instagram API with Instagram Login ---------------------------------------
# From: App Dashboard > Instagram > API setup with Instagram login >
#       3. Set up Instagram business login > Business login settings.
# NOT the Meta App ID / App Secret on the top-level Basic settings page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must exactly match the dashboard's OAuth redirect URI, byte for byte.
# HTTPS only, and no trailing slash (env.ts rejects both).
INSTAGRAM_REDIRECT_URI=https://your-domain.ngrok-free.app/api/auth/instagram/callback

# AES-256-GCM key for Creator.instagramTokenCiphertext.
# Generate with: openssl rand -base64 32
# Rotating this makes every stored token undecryptable — creators must reconnect.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Optional. Only set this if the deauthorize / data-deletion callbacks turn
# out to be signed with the top-level Meta app secret rather than the
# Instagram one. See lib/instagram/signed-request.ts.
META_APP_SECRET=
