{
  "version": 1,
  "protected": [
    "packages/database/**",
    "apps/worker/**",
    "apps/web/src/lib/**",
    "apps/web/src/test/**",
    "apps/web/src/app/api/**",
    "apps/web/src/proxy.ts",
    "apps/web/next.config.*",
    "**/vitest.config.*",
    "**/eslint.config.*",
    "**/tsconfig*.json",
    ".github/**",
    ".freebuff/**",
    ".gitleaks.toml",
    "**/.gitignore",
    "**/.gitattributes",
    "**/.npmrc",
    "**/docker-compose*.yml",
    "**/Dockerfile*",
    "**/vercel.json",
    "scripts/**",
    "docs/adr/**",
    "docs/engineering/**",
    "docs/plan/**",
    "**/package.json",
    "**/package-lock.json",
    "**/yarn.lock",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "**/.env*",
    "**/*.pem",
    "**/*.key"
  ],
  "fbForbiddenContent": [
    { "id": "database-client", "pattern": "@repo/database|@prisma/" },
    { "id": "server-auth", "pattern": "@clerk/nextjs/server" },
    { "id": "server-action", "pattern": "['\"]use server['\"]" },
    { "id": "server-only-api", "pattern": "next/headers|NextResponse|NextRequest" },
    { "id": "env-access", "pattern": "process\\.env" },
    { "id": "html-injection", "pattern": "dangerouslySetInnerHTML" },
    { "id": "dynamic-code", "pattern": "\\beval\\s*\\(|new\\s+Function\\s*\\(" },
    { "id": "child-process", "pattern": "child_process" },
    { "id": "raw-sql", "pattern": "\\$queryRaw|\\$executeRaw" }
  ]
}
