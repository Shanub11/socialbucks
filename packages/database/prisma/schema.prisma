// TARGET PATH: packages/database/prisma/schema.prisma
// (replaces Codex's User-only version — this restores Organization,
// Creator, Campaign, and CampaignCreatorSlot, updated to Prisma 7's
// format: no url/directUrl here, those live in prisma.config.ts only.)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // partialIndexes enables the `where:` clause on @@unique so we can
  // enforce uniqueness only among active (non-revoked) SocialAccount rows,
  // which is what reconnect-after-disconnect requires.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity ----------

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String
  firstName String?
  lastName  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships OrganizationMember[]
  creator     Creator?

  @@index([clerkId])
}

// ---------- Brands ----------

model Organization {
  id         String    @id @default(cuid())
  name       String
  clerkOrgId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  members   OrganizationMember[]
  campaigns Campaign[]
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ---------- Creators ----------

enum InstagramAccountType {
  PERSONAL
  BUSINESS
  CREATOR
}

model Creator {
  id        String    @id @default(cuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  instagramUserId      String?               @unique
  instagramUsername    String?
  instagramAccountType InstagramAccountType?
  instagramConnectedAt DateTime?

  instagramTokenCiphertext String?
  instagramTokenExpiresAt  DateTime?

  trustScore Int @default(0)

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots CampaignCreatorSlot[]
  socialAccounts SocialAccount[]

  @@index([instagramUserId])
}

// ---------- Social platform connections ----------
// One normalised table for every OAuth connection — Instagram today,
// YouTube next, others later — rather than a per-platform column set on Creator.
// The instagram* columns on Creator remain until the Step 2 migration backfills
// and drops them; see the migration for the exact cut-over sequence.

enum SocialPlatform {
  INSTAGRAM
  YOUTUBE
}

model SocialAccount {
  id          String         @id @default(cuid())
  creatorId   String
  platform    SocialPlatform

  /// Instagram: numeric user id (public, returned by /me). YouTube: UC… channel id.
  /// Not a secret — appears in public API responses. Left unencrypted so the
  /// @@unique constraint below can compare it (GCM ciphertext is non-deterministic
  /// due to random nonces; you cannot enforce uniqueness on it in Postgres).
  externalId  String

  /// @username / channel handle — display-only. Validate on write; never trust on read.
  handle      String?
  displayName String?

  /// Versioned ciphertext envelope: "v1.<iv_b64url>.<tag_b64url>.<ct_b64url>"
  /// Instagram: 60-day long-lived access token.
  /// YouTube: OAuth2 refresh token (no fixed expiry — see lastVerifiedAt).
  /// Null for YouTube when Google returns no refresh_token (e.g. no offline
  /// access); the connection row still records channel identity for audit,
  /// but no token is available for API calls until the creator re-authenticates.
  /// The format prefix lets the decrypt path be extended without a data migration.
  tokenCiphertext String?
  tokenExpiresAt  DateTime?

  /// OAuth scopes granted at connect time; stored for audit and re-consent detection.
  scopes         String[]

  connectedAt    DateTime  @default(now())

  /// Soft-delete: preserves audit trail for payout disputes.
  /// A revoked row does NOT block reconnecting the same account (see partial indexes below).
  revokedAt      DateTime?

  /// Drives the YouTube 30-day re-verification requirement.
  /// Also useful as a liveness signal for Instagram tokens we have not yet refreshed.
  lastVerifiedAt DateTime?

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  // Partial indexes — uniqueness is enforced only among ACTIVE connections
  // (revokedAt IS NULL). A revoked row becomes history and does not block:
  //   • reconnecting the same external account later, or
  //   • linking a different account on the same platform.
  // Named explicitly so the migration can reference them, and so pg_indexes
  // output is readable without decoding Prisma's generated naming scheme.
  @@unique([platform, externalId], where: { revokedAt: null }, map: "social_account_active_external_id_key")
  @@unique([creatorId, platform],  where: { revokedAt: null }, map: "social_account_active_creator_platform_key")

  @@index([creatorId])
  @@index([platform, lastVerifiedAt])
}

// ---------- Campaigns ----------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         CampaignStatus @default(DRAFT)

  totalBudget Decimal @db.Decimal(12, 2)
  currency    String  @default("USD")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  slots        CampaignCreatorSlot[]

  @@index([organizationId])
  @@index([status])
}

// ---------- Per-creator escrow / submission / approval state ----------

enum SlotStatus {
  INVITED
  ACCEPTED
  CONTENT_SUBMITTED
  CONTENT_APPROVED
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CANCELLED
}

enum MilestoneTier {
  BASELINE // 20%
  TIER_40
  TIER_70
  TIER_100
}

model CampaignCreatorSlot {
  id         String     @id @default(cuid())
  campaignId String
  creatorId  String
  status     SlotStatus @default(INVITED)

  escrowAmount Decimal        @db.Decimal(12, 2)
  currentTier  MilestoneTier?
  paidToDate   Decimal        @default(0) @db.Decimal(12, 2)

  contentUrl  String?
  submittedAt DateTime?
  approvedAt  DateTime?

  currentViewCount Int?
  lastViewCheckAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([campaignId, creatorId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([status])
}
